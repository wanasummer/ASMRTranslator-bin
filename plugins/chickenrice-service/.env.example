CHICKENRICE_HOST=0.0.0.0
CHICKENRICE_PORT=7870
CHICKENRICE_RUNTIME_DIR=/data
CHICKENRICE_DEVICE=cuda
CHICKENRICE_COMPUTE_TYPE=int8_float16
# 可选：自备 CUDA/cuDNN DLL 时指定目录；Windows 默认使用安装器下载的运行库
# CHICKENRICE_GPU_RUNTIME_DIR=C:\path\to\cuda-runtime\bin
# GPU 默认使用 engine-gpu；CPU 容器构建时改为 engine
CHICKENRICE_ENGINE_EXTRA=engine-gpu
# 对公网开放时务必设置；客户端使用 Authorization: Bearer <key>
CHICKENRICE_API_KEY=
# 可选：强制指定代理；未设置时安装器会自动探测常见本地代理端口
# CHICKENRICE_PROXY=http://127.0.0.1:7890
# 无代理时使用的国内镜像，可按服务器环境覆盖
CHICKENRICE_HF_ENDPOINT=https://hf-mirror.com
CHICKENRICE_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
CHICKENRICE_GITHUB_MIRROR=https://ghfast.top/
